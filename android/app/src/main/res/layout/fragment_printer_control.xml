<?xml version="1.0" encoding="utf-8"?>
<!-- Controlo da impressora 3D Geeetech i3 Pro W — estética dark/purple, PT-PT -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#14121F"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/textPrinterTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Controlo da Impressora"
            android:textColor="#C9A6FF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textPrinterSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Geeetech i3 Pro W"
            android:textColor="#8E8AA8"
            android:textSize="13sp" />

        <!-- Cartão de estado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_printer_purple"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estado"
                android:textColor="#8E8AA8"
                android:textSize="12sp"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/textPrinterState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Inactivo"
                android:textColor="#E6E1F5"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textPrinterJob"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Sem trabalho"
                android:textColor="#8E8AA8"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <ProgressBar
                android:id="@+id/progressPrinter"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#9C6BFF"
                android:progressBackgroundTint="#2A2440" />

            <TextView
                android:id="@+id/textPrinterProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0% — sem dados"
                android:textColor="#B9B3D9"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Cartão de temperaturas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_printer_purple"
            android:orientation="horizontal"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hotbed"
                    android:textColor="#8E8AA8"
                    android:textSize="12sp"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/textPrinterBed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="-- / -- °C"
                    android:textColor="#E6E1F5"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bico"
                    android:textColor="#8E8AA8"
                    android:textSize="12sp"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/textPrinterNozzle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="-- / -- °C"
                    android:textColor="#E6E1F5"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Configuração do servidor -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_printer_purple"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Servidor (OctoPrint/Klipper no homelab)"
                android:textColor="#8E8AA8"
                android:textSize="12sp"
                android:textAllCaps="true" />

            <EditText
                android:id="@+id/inputPrinterBaseUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="http://[IP_ADDRESS]"
                android:inputType="textUri"
                android:textColor="#E6E1F5"
                android:textColorHint="#5E5878"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/inputPrinterApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="Chave de API (opcional)"
                android:inputType="text"
                android:textColor="#E6E1F5"
                android:textColorHint="#5E5878"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Botões de comando -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPrinterStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#9C6BFF"
                android:text="Iniciar"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnPrinterPause"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#5E4B8B"
                android:text="Pausar"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnPrinterStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#7A2E4A"
                android:text="Parar"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPrinterRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#2A2440"
            android:text="Atualizar estado"
            android:textColor="#C9A6FF" />

        <TextView
            android:id="@+id/textPrinterError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text=""
            android:textColor="#FF8AA8"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
