<?xml version="1.0" encoding="utf-8"?>
<!-- Grelha de atalhos de serviços (dark/purple). Layout autónomo — não partilhado. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/dark_background"
    android:scrollbars="none"
    tools:context=".ServicesShortcutFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/services_titulo"
            android:textColor="@color/dark_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/services_subtitulo"
            android:textColor="@color/services_texto_suave"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDrisa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/services_drisa_voice"
            android:textAllCaps="false"
            app:backgroundTint="@color/purple_500"
            android:textColor="@android:color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfigurarServidor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/services_configurar_botao"
            android:textAllCaps="false"
            app:backgroundTint="@color/purple_500"
            android:textColor="@android:color/white" />

        <!-- Grelha de cards; preenchida a partir de ServiceCatalog -->
        <GridLayout
            android:id="@+id/gridServicos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:columnCount="2" />

    </LinearLayout>
</ScrollView>
