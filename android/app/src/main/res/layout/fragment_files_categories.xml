<?xml version="1.0" encoding="utf-8"?>
<!-- Secção "Ficheiros por categoria" (dark/purple). Layout autónomo — não partilhado. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/filesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/dark_background"
    android:scrollbars="none"
    tools:context=".FilesCategoryFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/files_titulo"
            android:textColor="@color/dark_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/files_subtitulo"
            android:textColor="@color/files_texto_suave"
            android:textSize="13sp" />

        <!-- Estado do share do homelab (configurável) -->
        <TextView
            android:id="@+id/textShareEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@color/files_texto_suave"
            android:textSize="12sp"
            tools:text="Homelab: não configurado (tocar para definir URL)" />

        <!-- Grelha de tiles por categoria (vista 1) -->
        <GridLayout
            android:id="@+id/gridCategorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="2" />

        <!-- Lista de ficheiros da categoria (vista 2) -->
        <LinearLayout
            android:id="@+id/listaFicheirosContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/textVoltar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:padding="8dp"
                android:text="@string/files_voltar"
                android:textColor="@color/purple_200"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textCategoriaTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/dark_text"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="📷 Fotos" />

            <ProgressBar
                android:id="@+id/progressFicheiros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textVazio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/files_vazio"
                android:textColor="@color/files_texto_suave"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Grelha/lista de ficheiros (2 colunas para Fotos/Vídeo/Áudio, lista para o resto) -->
            <GridLayout
                android:id="@+id/gridFicheiros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:columnCount="2" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
