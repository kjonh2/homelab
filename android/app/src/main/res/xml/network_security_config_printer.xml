<?xml version="1.0" encoding="utf-8"?>
<!-- Permite HTTP em claro para o servidor local do homelab (OctoPrint/Klipper, MJPEG) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
