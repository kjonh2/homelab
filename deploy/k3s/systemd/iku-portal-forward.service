[Unit]
Description=Loopback-only forward to the private Iku portal Service
After=k3s.service network-online.target
Requires=k3s.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/k3s kubectl -n iku port-forward --address=127.0.0.1 svc/iku-portal 13000:3000
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target
